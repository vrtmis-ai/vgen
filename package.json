{
  "name": "vgen-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Vgen Telegram Mini App — frontend (Vite + React)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b && tsc -p tsconfig.scripts.json --noEmit",
