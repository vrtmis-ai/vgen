{
  "name": "vgen-web",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@11.16.0",
  "type": "module",
  "description": "DEEV AI creation website — frontend (Vite + React)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "infra:up": "docker compose up -d --wait",
    "dev:stack": "npm run infra:up && pnpm db:migrate && pnpm --parallel --filter vgen-web --filter @vgen/api --filter @vgen/worker dev",
    "typecheck": "tsc -b && tsc -p tsconfig.scripts.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint src scripts e2e *.config.ts",
    "format": "prettier --write src scripts e2e apps packages *.json *.ts *.md *.yaml",
    "format:check": "prettier --check src scripts e2e apps packages *.json *.ts *.md *.yaml",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "backend:typecheck": "pnpm --filter \"@vgen/*\" typecheck",
    "backend:lint": "eslint apps packages",
    "backend:test": "pnpm --filter \"@vgen/*\" test",
    "backend:test:integration": "pnpm --filter @vgen/db test:integration",
    "backend:migrate:check": "pnpm --filter @vgen/db migration:check",
    "db:migrate": "pnpm --filter @vgen/db migrate",
    "backend:check": "pnpm backend:typecheck && pnpm backend:lint && pnpm backend:test && pnpm backend:migrate:check",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run check:catalog",
    "check:catalog": "tsx scripts/check-combos.ts",
    "catalog:publish": "tsx scripts/publish-catalog.ts",
    "check:pricing": "tsx scripts/check-live-pricing.ts"
  },
  "dependencies": {
    "@clerk/react": "^6.14.1",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/syne": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "5.101.4",
    "framer-motion": "^12.42.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.2",
    "zod": "4.4.3",
    "@vgen/core": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "^26.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "dotenv": "^17.4.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.9.0",
    "jsdom": "30.0.1",
    "postgres": "^3.4.9",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "8.67.0",
    "vite": "^6.0.7",
    "vitest": "4.1.10"
  },
  "overrides": {
    "nanoid": "3.3.17"
  }
}
