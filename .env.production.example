# ---------------------------------------------------------------------------
#  Production template. Copy to .env.production on the VPS and fill it in.
#
#      cp .env.production.example .env.production
#
#  .env.production is gitignored and must stay that way. Every value below is
#  read by docker-compose.prod.yml, and the file is named twice on the command
#  line — once for compose's own substitutions, once for the containers:
#
#      docker compose --env-file .env.production -f docker-compose.prod.yml up -d
#
#  The API refuses to boot in production with any of the infrastructure values
#  missing, rather than starting with a local default and failing later in a
#  way that is expensive to read. An empty value here is a failed deploy, which
#  is the cheap version of the same discovery.
# ---------------------------------------------------------------------------

NODE_ENV=production

# --- Names -----------------------------------------------------------------
# Write the scheme. `https://` means Caddy gets its own certificate over ACME;
# `http://` means TLS is already terminated in front of it, by an Iranian CDN
# or a load balancer. A bare hostname means https, which behind a CDN is a
# redirect loop rather than an error.
SITE_ADDRESS=https://deev.ir
# The object store's public name. It needs its own hostname, not a path under
# the site: an S3 signature covers the whole path, so a stripped prefix breaks
# every signature and an unstripped one makes MinIO look for a bucket called
# "files". Point a second A record at this same server.
FILES_ADDRESS=https://files.deev.ir
# Certificate expiry warnings are opt-in and live in docker/Caddyfile rather
# than here — an empty environment reference in that file stops Caddy parsing
# its own config, which is a worse failure than not being warned.

# --- The browser bundle ----------------------------------------------------
# Compiled INTO the web image at build time, not read when the container
# starts. Changing it requires `docker compose build web`; restarting does
# nothing. The API shares the site's origin, which is what keeps the session
# cookie same-site and makes CORS a non-question.
NEXT_PUBLIC_API_BASE_URL=https://deev.ir/api/v1
# Optional. Appears in sanitized crash reports so a report can be tied to a
# deploy; a git short sha is the usual thing.
NEXT_PUBLIC_APP_RELEASE=

# --- Postgres --------------------------------------------------------------
# Generate the password once and keep it: openssl rand -hex 24
# DATABASE_URL must carry the same password, and the host is the compose
# service name. These being out of step is the single most common bad deploy —
# it presents as "password authentication failed for user vgen".
POSTGRES_DB=vgen
POSTGRES_USER=vgen
POSTGRES_PASSWORD=
DATABASE_URL=postgres://vgen:THE_SAME_PASSWORD@postgres:5432/vgen

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://redis:6379

# --- The API ---------------------------------------------------------------
API_PORT=5181
# Both are the site's public origin, because Caddy serves the app and the API
# from one hostname. WEB_ORIGIN is what CORS allows; API_PUBLIC_URL is what the
# OAuth redirect URIs are built from, so it must match what is registered with
# Google and Microsoft exactly.
WEB_ORIGIN=https://deev.ir
API_PUBLIC_URL=https://deev.ir
# The compose network's pinned subnet — Caddy's address as the API sees it.
# Fastify believes X-Forwarded-For only from an address it trusts, and without
# this every visitor shares one rate-limit bucket under the proxy's IP. Do NOT
# write `true`: that lets any client forge the header and skip the limiter.
# Behind a CDN as well, append its published ranges, comma-separated — otherwise
# the client IP the API sees is the CDN's.
TRUST_PROXY=172.28.0.0/16
# openssl rand -hex 32. HMACs transient rate-limit subjects so Redis never
# holds a raw phone number or IP. Safe to rotate: it only resets live buckets.
RATE_LIMIT_HASH_SECRET=

# --- Two values that can never be changed again ----------------------------
# Generate both now, write them down somewhere that is not this server, and
# back them up before the first boot. Each: openssl rand -hex 32
#
# PHONE_HASH_PEPPER salts the phone hash behind the one-free-trial-per-person
# record, which outlives the account it belonged to. Changing it re-opens the
# free trial for every number that has ever signed up.
PHONE_HASH_PEPPER=
# MFA_SEALING_KEY seals TOTP secrets at rest, so the database alone cannot
# produce a code. Changing it invalidates every staff enrolment at once — the
# admin panel included, and it is the admin panel that grants credits.
MFA_SEALING_KEY=

# --- Object storage --------------------------------------------------------
# The access key pair is also MinIO's root credential, so generate a real one:
# openssl rand -hex 16 for the key, openssl rand -hex 32 for the secret.
OBJECT_STORAGE_BUCKET=vgen
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=us-east-1
# Where the API and the worker connect: the internal service, never published.
OBJECT_STORAGE_ENDPOINT=http://minio:9000
# The name signed URLs carry, which has to be reachable from outside because
# two readers are: the browser, for every gallery item, and the generation
# provider, which fetches each reference image from its own servers. Leave this
# unset and reference-based generation fails everywhere with an error that
# looks like the provider misbehaving. Must equal FILES_ADDRESS.
OBJECT_STORAGE_PUBLIC_ENDPOINT=https://files.deev.ir

# --- Sign-in ---------------------------------------------------------------
# Required. Without both halves the API prints codes to the console in
# development and refuses to start at all in production — phone OTP is the
# route Iranian users actually take, so a deploy without a gateway has no way
# for anyone to sign in.
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=

# Optional, and optional one at a time: without both halves of a pair those two
# endpoints are simply not registered. Neither provider is reliably reachable
# from Iran without a VPN, so treat them as a convenience rather than a route.
# The redirect URI registered with each must be
# ${API_PUBLIC_URL}/api/v1/auth/{google,microsoft}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# --- Generation providers --------------------------------------------------
# Nothing generates until one of these holds credit AND an admin activates a
# model route — every seeded route ships inactive on purpose. Until then a job
# fails `provider_unavailable` and the customer is refunded in full.
#
# KIE is the one to fund first: its adapter is the only one a spike proved by
# spending real credits. WaveSpeed's submit path and all three of its failure
# modes are known; its success path has never run.
KIE_API_KEY=
WAVESPEED_API_KEY=

# The three PixVerse accounts behind unlimited generation. The useapi adapter
# is unwritten — no token has ever exercised their API — so a generation routed
# there fails cleanly and costs the customer nothing.
USEAPI_PIXVERSE_ACCOUNT_1=
USEAPI_PIXVERSE_ACCOUNT_2=
USEAPI_PIXVERSE_ACCOUNT_3=

# --- Sizing ----------------------------------------------------------------
# Matched to the worker's own Postgres pool, which is 4. The default is 8, so
# out of the box eight concurrent generations contend for four connections.
# Raise both together or neither, and measure before assuming it helps.
WORKER_CONCURRENCY=4
# Per account per minute, across the customer routes. Sized from a real
# session: opening the studio fires five or six reads at once.
RATE_LIMIT_READS_PER_MINUTE=600
RATE_LIMIT_WRITES_PER_MINUTE=60
