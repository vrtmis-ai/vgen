# Generated by the package manager, and the only writer that may touch it.
# Reformatting a lockfile gains nothing and risks a file that resolves installs.
package-lock.json
pnpm-lock.yaml
src/design-system/*.md

# Written by `pnpm catalog:snapshot` straight out of Postgres, and diffed in CI
# against what the database serves. Prettier collapses short JSON objects onto
# one line and JSON.stringify does not, so formatting it would make that diff
# fail on whitespace forever.
src/data/catalog.snapshot.json

# The same, for pricing. `pricing.rows.json` is the price list the database is
# seeded from and the browser quotes from; `pricing.expected.json` is every
# price the app charged before pricing moved into Postgres, frozen so
# `pnpm check:pricing` can prove none of them moved. Both are generated, both
# are diffed, and neither is hand-edited.
src/data/pricing.rows.json
src/data/pricing.expected.json
