# ---------------------------------------------------------------------------
#  The only container with a published port.
#
#  Both addresses come from the environment so one file covers the two ways
#  this gets deployed:
#
#    SITE_ADDRESS=https://deev.ir    Caddy gets its own certificate over ACME
#    SITE_ADDRESS=http://deev.ir     TLS already terminated upstream, by an
#                                    Iranian CDN or a load balancer
#
#  Write the scheme explicitly either way. A bare `deev.ir` means "https, and
#  manage the certificate", which behind a CDN is a redirect loop rather than
#  an error.
# ---------------------------------------------------------------------------
# There is deliberately no global options block. An `email {$ACME_EMAIL}` line
# here is the obvious way to get Let's Encrypt's expiry warnings, and it is also
# a directive with an argument count: unset, the variable expands to nothing and
# Caddy refuses to parse its own config on a deployment that has otherwise done
# everything right. Certificates are issued without a contact address anyway. To
# get the warnings, add a real one here rather than an environment reference:
#
#     {
#     	email you@example.com
#     }

{$SITE_ADDRESS} {
	encode zstd gzip

	# Response headers, on everything this address serves.
	#
	# HSTS: without it the first visit of the day is a plaintext request that a
	# network between the customer and us can answer instead. Caddy already
	# redirects http to https, but the redirect is itself the interceptable
	# part. Note the deployment note at the top: with TLS terminated by a CDN
	# the browser is still speaking https to that CDN, so this remains correct.
	# `preload` is deliberately absent — that is a submission to a browser list
	# and hard to walk back, so it should be a decision rather than a default.
	#
	# frame-ancestors: /admin can grant credits, ban accounts and re-route
	# traffic. The staff cookie is SameSite=Strict and so is not sent in a
	# cross-site frame at all, which already defeats clickjacking here; this
	# says the same thing a second way, in the header browsers enforce before
	# any cookie decision. X-Frame-Options repeats it for anything old.
	#
	# Deliberately NOT a full Content-Security-Policy. Next inlines its
	# hydration bootstrap, so a script-src worth having needs per-response
	# nonces threaded through the app, and a policy written blind here would
	# either break the site or be broad enough to be decoration. frame-ancestors
	# is the half that is exact and costs nothing.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
		Referrer-Policy "strict-origin-when-cross-origin"
		# The version number is free reconnaissance and buys the visitor nothing.
		-Server
	}

	# The API and the app share one origin, which is not laziness — it is what
	# makes the session cookie same-site and the CORS preflight moot. WEB_ORIGIN
	# and API_PUBLIC_URL are both this address for the same reason.
	handle /api/* {
		reverse_proxy api:5181
	}

	# Deliberately public and unauthenticated: this is what a monitor polls, and
	# /health/ready reports only which dependency is up, never why.
	handle /health/* {
		reverse_proxy api:5181
	}

	handle {
		reverse_proxy web:5180
	}
}

# ---------------------------------------------------------------------------
#  The object store, on its own hostname.
#
#  It has to be publicly reachable, which the code did not always assume and
#  the old comments still deny. Two callers need it and neither is on this
#  network: the browser, which is handed a signed URL for every gallery item,
#  and the PROVIDER, which is handed a signed URL for every reference image and
#  fetches it from its own servers. Point OBJECT_STORAGE_ENDPOINT at a private
#  address and reference-based generation cannot work from anywhere.
#
#  A hostname and not a path prefix. An S3 signature covers the full path, so
#  serving this under `/files/*` and stripping the prefix invalidates every
#  signature; leaving the prefix on means MinIO looks for a bucket named
#  "files". A subdomain changes neither the path nor the signed Host.
# ---------------------------------------------------------------------------
{$FILES_ADDRESS} {
	# Uploads never come this way — the API and the worker write to MinIO over
	# the internal network, and the browser posts its files to the API instead
	# of holding a presigned PUT. So nothing legitimate mutates through this
	# hostname, and refusing here means a leaked storage credential still
	# cannot write anything from outside the VPS.
	@mutating not method GET HEAD OPTIONS
	respond @mutating 405

	# `nosniff` matters more here than on the site: this hostname serves bytes
	# that customers and providers supplied. Uploads are already restricted to
	# four image types by their magic bytes rather than their declared header,
	# so this is the second lock — it stops a browser deciding for itself that a
	# stored file is really HTML and running it. Being a separate hostname, an
	# error here still could not reach a session cookie on the main domain.
	#
	# `sandbox` and `default-src 'none'` would be the stronger policy here and
	# are deliberately not set: this host serves video, and range requests and
	# media playback are exactly the things a blind CSP breaks. Worth adding
	# once it can be tested against a real clip rather than reasoned about.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Content-Security-Policy "frame-ancestors 'none'"
		-Server
	}

	reverse_proxy minio:9000
}
