node_modules
dist
dist-ssr
*.local
.DS_Store
*.log

# pnpm is the package manager (see `packageManager` in package.json). npm cannot
# install this repo at all — the root package.json declares
# "@vgen/core": "workspace:*", a protocol npm rejects — so an npm lockfile here
# is never right, only stale.
package-lock.json
yarn.lock

.env
.env.*
!.env.example
!.env.e2e
!.env.production.example
*.tsbuildinfo

# Next build output. next-env.d.ts is deliberately NOT ignored: tsconfig lists it
# explicitly, and `pnpm typecheck` can run before any `next build` has generated
# it — on a fresh clone that is a hard "file not found" rather than a warning.
.next/

# internal notes — keep private
KIE_MODELS.md
HANDOFF.md

# the Obsidian memory vault. Holds server addresses, provider economics and the
# margin; this repo is public, so the vault never is. `.raw/` is the immutable
# source layer the wiki is written from, `.obsidian/` is per-machine UI state.
wiki/
.raw/
.obsidian/

# raw API responses from scripts/spike-kie.ts — may contain account details
scripts/spike-out/

# local-only: Stitch reference screens, served for side-by-side comparison
public/_ref/

# Playwright run artifacts
test-results/

# Playwright MCP scratch output (console logs, page snapshots, screenshots)
.playwright-mcp/
