{
  "name": "@vgen/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "migrate": "tsx src/migrate.ts",
    "catalog:snapshot": "tsx src/exportCatalogSnapshot.ts",
    "content:snapshot": "tsx src/exportContentSnapshot.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "migration:check": "vitest run --config vitest.integration.config.ts",
    "plans:snapshot": "tsx src/exportPlansSnapshot.ts"
  },
  "dependencies": {
    "@vgen/contracts": "workspace:*",
    "@vgen/core": "workspace:*",
    "dotenv": "^17.4.2",
    "postgres": "^3.4.0"
  }
}
