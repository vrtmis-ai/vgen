{
  "compilerOptions": {
    "composite": true,
    // `composite` implies emit, and with no outDir tsc dropped vite.config.js and
    // vite.config.d.ts next to the source on every cold build. Vite resolves
    // vite.config.js BEFORE vite.config.ts, so local builds were reading a stale
    // transpile while CI — a fresh checkout, where the gitignored .js does not
    // exist — read the real thing. Same commit, two different configs. Send the
    // build artefacts somewhere ignored instead.
    "outDir": "./node_modules/.tmp/tsconfig-node",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "include": ["vite.config.ts"]
}
