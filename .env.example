# Browser runtime. Use demo only for local UI development.
# NEXT_PUBLIC_ is the browser bundle: anything here is served to every visitor.
NEXT_PUBLIC_APP_MODE=demo
# Required once the HTTP adapters and backend are enabled.
NEXT_PUBLIC_API_BASE_URL=
# Build/release identifier included in sanitized crash reports.
NEXT_PUBLIC_APP_RELEASE=
# Demo mode only. Set to 1 to start signed out, which is how a sign-in screen is
# built without a backend. Left unset the demo session is already authed, so
# every other screen is reachable without one.
NEXT_PUBLIC_DEMO_ANONYMOUS=

# API runtime (never prefix secrets with NEXT_PUBLIC_)
DATABASE_URL=postgres://vgen:vgen-local@127.0.0.1:5442/vgen
WEB_ORIGIN=http://127.0.0.1:5180
# Exact reverse-proxy IP/CIDR in production. Do not use true on a public API.
TRUST_PROXY=
API_PORT=5181
REDIS_URL=redis://127.0.0.1:6379
# Required in production; used only to HMAC transient rate-limit subjects.
RATE_LIMIT_HASH_SECRET=
# Salts the phone hash behind the one-trial-per-person record, which outlives
# the account. Deploy-once: changing it re-opens the free trial for every
# existing number.
PHONE_HASH_PEPPER=
# Public origin of THIS API, used to build the Google redirect URI.
API_PUBLIC_URL=http://127.0.0.1:5181

# SMS gateway for phone OTP. Without both, the API falls back to printing codes
# to the console — which refuses to start in production.
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=

# Social sign-in. Each is optional and independent: without both halves of a
# pair, that provider's two endpoints are not registered at all. Note neither
# Google nor Microsoft is reliably reachable from Iran, so phone OTP is the
# route most users will actually take.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Which Microsoft audience may sign in: common (work, school and personal),
# organizations, consumers, or a single tenant GUID. Defaults to common.
# This is NOT cosmetic — under the three multi-tenant values Microsoft omits
# unverified addresses from the token, which is what allows an email to be
# trusted for account linking. Pin it to one tenant and that guarantee is gone,
# so an address is believed only on an explicit xms_edov optional claim. Read
# emailIsVerified in apps/api/src/auth/microsoftOAuth.ts before changing it.
MICROSOFT_TENANT=common
# The object store holds uploaded references and every finished generation.
# It is reached only by the API and the worker — never by a browser — which is
# why uploads are proxied through the API instead of presigned. In production
# it can sit on a private network with no public port and no CORS.
OBJECT_STORAGE_BUCKET=vgen
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=vgen-local
OBJECT_STORAGE_SECRET_KEY=vgen-local-secret

# The generation worker calls KIE with this. The name matches the secret_ref on
# the provider_credentials row the catalogue seeder writes — the database stores
# the name, this file holds the value. Never expose it as a NEXT_PUBLIC_ variable.
# Without it the worker refuses every job and refunds it, rather than failing
# halfway with the customer's credits still held.
KIE_API_KEY=

# WaveSpeed, the second generation provider. Nothing reaches it until an
# admin activates a model_routes row, so an unset key here is not an outage —
# it is the default state, and `GET /api/v1/admin/providers` reports it.
WAVESPEED_API_KEY=

# The three connected PixVerse accounts behind unlimited generation, again by
# name from provider_credentials.secret_ref. Nothing calls these yet: the useapi
# adapter is unwritten because no token has ever exercised their API, and a
# generation routed there fails cleanly and costs the customer nothing.
USEAPI_PIXVERSE_ACCOUNT_1=
USEAPI_PIXVERSE_ACCOUNT_2=
USEAPI_PIXVERSE_ACCOUNT_3=

# How many generations one worker process polls at once. Not a per-account limit
# (that is the plan's max_concurrent_jobs) and not a per-provider one (that is
# the credential pool).
WORKER_CONCURRENCY=8

# Seals TOTP secrets at rest, so mfa_credentials.secret_ref is useless without
# a key held outside the database. Rotating it invalidates every enrolment.
MFA_SEALING_KEY=
